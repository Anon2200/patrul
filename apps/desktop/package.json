{
  "name": "patrul-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Патруль: приложение для Windows (оболочка над сайтом)",
  "author": "Patrul",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ru.patrul.desktop",
    "productName": "Патруль",
    "artifactName": "Patrul-Setup-${version}.${ext}",
    "files": ["main.js", "offline.html", "package.json"],
    "extraResources": [{ "from": "../app-config.json", "to": "app-config.json" }],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false, "createDesktopShortcut": true }
  }
}
